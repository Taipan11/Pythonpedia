# Application
APP_NAME="Pythonpédia"
APP_VERSION="0.1.0"
DEBUG=true

# Serveur
HOST=127.0.0.1
PORT=8888

# Stockage
STORAGE_BACKEND=sqlite
DB_PATH=storage/pythonpedia.sqlite3

# Communication réseau
REQUEST_TIMEOUT=5.0
MAX_RESPONSE_BYTES=1048576
MAX_CONCURRENT_REQUESTS=10

# Administration
ADMIN_API_KEY=change-me

# Découverte de serveurs
DISCOVERY_CANDIDATES=[]